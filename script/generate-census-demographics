function divide(numerator, denominator) {
  if (!Number.isFinite(numerator) || !Number.isFinite(denominator) || denominator === 0) return null;
  return numerator / denominator;
}

function ratioPercent(numerator, denominator) {
  const ratio = divide(numerator, denominator);
  return ratio === null ? null : ratio * 100;
}

function sumVariables(estimate, tableId, variableIds) {
  let total = 0;
  for (const variableId of variableIds) {
    const value = estimate(tableId, variableId);
    if (!Number.isFinite(value)) return null;
    total += value;
  }
  return total;
}

function roundValue(value, digits = 2) {
  if (!Number.isFinite(value)) return null;
  const multiplier = 10 ** digits;
  return Math.round(value * multiplier) / multiplier;
}

function getTableValue(record, kind, tableId, variableId) {
  const value = record && record[tableId] && record[tableId][kind] && record[tableId][kind][variableId];
  return Number.isFinite(value) ? value : null;
}

function buildMetricConfig(release) {
  return {
    generated_at: new Date().toISOString(),
    source_date: sourceDate,
    source_county: countyGeoId,
    release,
    geographies: Object.fromEntries(Object.entries(geographyLevels).map(([id, level]) => [id, {
      label: level.label,
      filename: level.filename,
      census_reporter_children: level.censusReporterChildren,
      tigerweb_layer: level.tigerwebLayer
    }])),
    categories: metricCategories.map((category) => ({
      id: category.id,
      label: category.label,
      metrics: category.metrics.map((metric) => ({
        id: metric.id,
        label: metric.label,
        description: metric.description,
        unit: metric.unit,
        format: metric.format,
        source_tables: metric.sourceTables,
        variables: metric.variables,
        supported_geographies: metric.supportedGeographies
      }))
    })),
    notes: [
      "ACS figures are estimates, not exact counts.",
      "Derived rates use Census table denominators listed in the metric configuration.",
      "Margins of error are included for direct estimates where published. Derived-rate margins of error are not calculated in this first implementation; numerator and denominator values are preserved for review.",
      "Block-group estimates can have high uncertainty. Treat small-area values as directional, especially when denominators are small."
    ]
  };
}

async function fetchJson(url, label) {
  const response = await fetch(url, {
    headers: {
      Accept: "application/json",
      "User-Agent": "rayhollister.com census demographic data generator"
    }
  });
  if (!response.ok) {
    throw new Error(`Could not fetch ${label}: ${response.status} ${response.statusText}`);
  }
  return response.json();
}

async function fetchTigerwebGeometry(level) {
  const fields = [
    "GEOID",
    "BASENAME",
    "NAME",
    "STATE",
    "COUNTY",
    "TRACT",
    level.id === "blockGroup" ? "BLKGRP" : "",
    "AREALAND",
    "AREAWATER",
    "INTPTLAT",
    "INTPTLON"
  ].filter(Boolean).join(",");
  const params = new URLSearchParams({
    where: "STATE='12' AND COUNTY='031'",
    outFields: fields,
    returnGeometry: "true",
    f: "geojson"
  });
  return fetchJson(`${tigerwebBaseUrl}/${level.layerId}/query?${params}`, level.label);
}

async function fetchCensusReporterData(level) {
  const sourceTables = getSourceTablesForGeography(level.id);
  const params = new URLSearchParams({
    table_ids: sourceTables.join(",")
  });
  return fetchJson(`${censusReporterBaseUrl}?${params}&geo_ids=${level.censusReporterChildren}`, `Census Reporter ${level.label}`);
}

function getSourceTablesForGeography(levelId) {
  const tableIds = new Set();
  metricCategories.forEach((category) => {
    category.metrics.forEach((metric) => {
      if (!metric.supportedGeographies.includes(levelId)) return;
      metric.sourceTables.forEach((tableId) => {
        if (/^B\d/.test(tableId)) {
          tableIds.add(tableId);
        }
      });
    });
  });
  return Array.from(tableIds).sort();
}

function buildMetricValues(featureProperties, censusData, release, levelId) {
  const landSquareMiles = Number(featureProperties.AREALAND) / squareMetersPerSquareMile;
  const context = {
    estimate: (tableId, variableId) => getTableValue(censusData, "estimate", tableId, variableId),
    error: (tableId, variableId) => getTableValue(censusData, "error", tableId, variableId),
    landSquareMiles
  };
  const metrics = {};

  for (const category of metricCategories) {
    for (const metric of category.metrics) {
      if (!metric.supportedGeographies.includes(levelId)) continue;
      const value = roundValue(metric.value(context));
      const numerator = metric.numerator ? metric.numerator(context) : null;
      const denominator = metric.denominator ? metric.denominator(context) : null;
      const moe = metric.moe ? metric.moe(context) : null;
      metrics[metric.id] = {
        value,
        moe: Number.isFinite(moe) ? roundValue(moe) : null,
        numerator: Number.isFinite(numerator) ? roundValue(numerator) : null,
        denominator: Number.isFinite(denominator) ? roundValue(denominator) : null,
        release: release && release.id ? release.id : "",
        vintage: release && release.years ? release.years : ""
      };
    }
  }

  return metrics;
}

function normalizeFeature(feature, levelId, level, censusReporterData) {
  const properties = feature.properties || {};
  const geoid = String(properties.GEOID || "");
  const censusReporterGeoid = `${level.censusReporterPrefix}${geoid}`;
  const censusData = censusReporterData.data && censusReporterData.data[censusReporterGeoid];
  const label = levelId === "blockGroup"
    ? `Block Group ${properties.BLKGRP}, Census Tract ${properties.TRACT}`
    : properties.NAME || `Census Tract ${properties.BASENAME || properties.TRACT}`;

  if (!censusData) {
    throw new Error(`Missing Census Reporter data for ${censusReporterGeoid}`);
  }

  return {
    type: "Feature",
    geometry: feature.geometry,
    properties: {
      geoid,
      census_reporter_geoid: censusReporterGeoid,
      geography_level: levelId,
      label,
      name: properties.NAME || label,
      basename: properties.BASENAME || "",
      state: properties.STATE || "12",
      county: properties.COUNTY || "031",
      tract: properties.TRACT || "",
      block_group: properties.BLKGRP || "",
      land_area_sq_mi: roundValue(Number(properties.AREALAND) / squareMetersPerSquareMile, 4),
      water_area_sq_mi: roundValue(Number(properties.AREAWATER) / squareMetersPerSquareMile, 4),
      source: "U.S. Census Bureau TIGERweb geometry joined to Census Reporter ACS estimates",
      source_url: tigerwebBaseUrl,
      census_reporter_url: `https://censusreporter.org/profiles/${censusReporterGeoid}/`,
      acs_release: censusReporterData.release && censusReporterData.release.id,
      acs_years: censusReporterData.release && censusReporterData.release.years,
      metrics: buildMetricValues(properties, censusData, censusReporterData.release, levelId)
    }
  };
}

async function writeJson(filename, data) {
  const outputPath = path.join(dataDirectory, filename);
  await fs.writeFile(outputPath, `${JSON.stringify(data)}\n`);
  console.log(`Wrote ${outputPath}`);
}

async function main() {
  let release;
  const outputs = {};

  await fs.mkdir(dataDirectory, { recursive: true });

  for (const [levelId, level] of Object.entries(geographyLevels)) {
    console.log(`Fetching ${level.label} geometry and ACS data...`);
    const levelWithId = Object.assign({ id: levelId }, level);
    const [geometry, censusReporterData] = await Promise.all([
      fetchTigerwebGeometry(levelWithId),
      fetchCensusReporterData(levelWithId)
    ]);
    release = release || censusReporterData.release;
    const features = (geometry.features || []).map((feature) => normalizeFeature(feature, levelId, level, censusReporterData));
    outputs[levelId] = {
      type: "FeatureCollection",
      name: level.label,
      generated_at: new Date().toISOString(),
      source_date: sourceDate,
      source_county: countyGeoId,
      acs_release: censusReporterData.release,
      features
    };
    await writeJson(level.filename, outputs[levelId]);
  }

  await writeJson("census-demographic-metrics.json", buildMetricConfig(release));

  console.log("Census demographic assets generated.");
  for (const [levelId, output] of Object.entries(outputs)) {
    console.log(`${levelId}: ${output.features.length.toLocaleString()} features`);
  }
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
